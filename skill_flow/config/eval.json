{
  "system": {},
  "index": {
    "input_corpus_path": "../skill-crawler/data/skills/",
    "output_index_path": "outputs/indices/"
  },
  "models": {
    "retriever": {
      "model_name": "BAAI/bge-base-en-v1.5",
      "query_prompt": "Represent this sentence for searching relevant passages: ",
      "batch_size": 256,
      "top_k": 1000,
      "eval": {
        "enabled": true,
        "tasks_dir": "integration/skillsbench/tasks",
        "max_query_chars": 0,
        "output_path": "outputs/eval-retriever-results.json"
      }
    },
    "reranker": {
      "model_name": "BAAI/bge-reranker-v2-m3",
      "top_k": 100,
      "batch_size": 128,
      "max_content_chars": 512,
      "query_gen": {
        "enabled": true,
        "model": "gpt-4o-mini",
        "max_tokens": 200,
        "temperature": 0.0,
        "cache_path": "outputs/query_gen_cache.json"
      },
      "eval": {
        "enabled": true,
        "stage1_report_path": "outputs/eval-retriever-results.json",
        "tasks_dir": "integration/skillsbench/tasks",
        "output_path": "outputs/eval-reranker-results.json"
      }
    },
    "reranker2": {
      "model_name": "BAAI/bge-reranker-v2-m3",
      "top_k": 10,
      "batch_size": 32,
      "max_content_chars": 32000,
      "query_gen": {
        "enabled": true,
        "model": "gpt-4o-mini",
        "max_tokens": 200,
        "temperature": 0.0,
        "cache_path": "outputs/query_gen_cache.json"
      },
      "eval": {
        "enabled": true,
        "stage2_report_path": "outputs/eval-reranker-results.json",
        "tasks_dir": "integration/skillsbench/tasks",
        "output_path": "outputs/eval-reranker2-results.json"
      }
    },
    "selector": {
      "enabled": false,
      "model": "gpt-4o-mini",
      "system_instruction": "skill_flow/selector/instructions/system_v0.1.j2",
      "user_instruction": "skill_flow/selector/instructions/user_v0.1.j2",
      "max_tokens": 1024,
      "temperature": 0.0,
      "top_k": 5,
      "cache_path": "outputs/selector_cache.json",
      "eval": {
        "enabled": true,
        "stage3_report_path": "outputs/eval-reranker2-results.json",
        "tasks_dir": "integration/skillsbench/tasks",
        "output_path": "outputs/eval-selector-results.json"
      }
    }
  }
}
