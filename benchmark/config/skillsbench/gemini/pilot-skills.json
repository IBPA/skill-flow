{
  "jobs_dir": "outputs/evaluation",
  "model": "google/gemini-3.1-flash-lite",
  "agent": "gemini",
  "tasks_path": "integration/skillsbench/tasks",
  "num_runs": 1,
  "environment": {
    "use_daytona": true,
    "n_concurrent": 5
  },
  "tasks": {
    "include_tasks": [
      "earthquake-plate-calculation",
      "flood-risk-analysis",
      "software-dependency-audit",
      "powerlifting-coef-calc",
      "econ-detrending-correlation"
    ],
    "exclude_tasks": []
  },
  "retry": {
    "resume": false,
    "retry_errors": false,
    "retry_tasks": [],
    "retry_error_types": [
      "AgentSetupTimeoutError",
      "CancelledError",
      "EnvironmentStartTimeoutError",
      "RewardFileNotFoundError",
      "VerifierTimeoutError",
      "RuntimeError",
      "DaytonaNotFoundError",
      "AddTestsDirError"
    ]
  },
  "job_name": "gemini-pilot-skills"
}
